# Uygulama
LOG_LEVEL=INFO

# GÜVENLİK: PII pseudonymization için kullanılan HMAC salt değeri.
# Üretimde güçlü ve rastgele bir değer seçilmeli; boş bırakılırsa
# audit kayıtlarındaki müşteri ref'i güvenli olmaz.
PII_HASH_SALT=degistir-beni-guclu-bir-deger-sec

# Karar motoru eşikleri
MARGIN_THRESHOLD=0.08
HIGH_VALUE_THRESHOLD=100000
STRATEGIC_DISCOUNT_THRESHOLD=15



# Yanıtta marj yüzdesi gösterilsin mi? (false → gizle; rol tabanlı erişim kontrolü bağlantı noktası)
INCLUDE_MARGIN_DETAILS=true

# AI konfigürasyonu (LLM_PROVIDER -> openai)
LLM_PROVIDER=mock
#OPENAI_API_KEY=sk-...
#LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=10
LLM_MAX_TOOL_ITERATIONS=3
# GÜVENLİK: true iken AI katmanı kasıtlı hata üretir; fallback yolunu test etmek için
LLM_FORCE_FAILURE=false